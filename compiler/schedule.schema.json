{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-cake-ir.local/schema/schedule-v1",
  "title": "Open Cake Schedule v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schedule_id", "target", "roles", "allocations", "buffers", "pipelines", "barriers", "operations", "outputs", "metadata"],
  "properties": {
    "schema_version": {"const": 1},
    "schedule_id": {"type": "string", "minLength": 1},
    "target": {"const": "sm_100a"},
    "grid": {"$ref": "#/$defs/grid"},
    "program_map": {"type": "object"},
    "tile_loops": {"type": "array", "items": {"type": "object"}},
    "access_maps": {"type": "array", "items": {"type": "object"}},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "warps"],
        "properties": {
          "name": {"$ref": "#/$defs/name"},
          "warps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "space", "size_bytes"],
        "properties": {
          "name": {"$ref": "#/$defs/name"},
          "space": {"enum": ["shared", "tensor"]},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "buffers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "space", "dtype", "shape", "mode"],
        "properties": {
          "name": {"$ref": "#/$defs/name"},
          "space": {"enum": ["global", "shared", "tensor", "register"]},
          "dtype": {"enum": ["bf16", "fp16", "fp32", "int32", "int64"]},
          "shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
          "mode": {"enum": ["input", "output", "scratch"]},
          "allocation": {"$ref": "#/$defs/name"},
          "byte_offset": {"type": "integer", "minimum": 0},
          "stages": {"type": "integer", "minimum": 1}
        }
      }
    },
    "pipelines": {"type": "array", "items": {"type": "object"}},
    "barriers": {"type": "array", "items": {"type": "object"}},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "role", "reads", "writes", "parameters"],
        "properties": {
          "id": {"$ref": "#/$defs/name"},
          "kind": {"enum": ["load", "mma", "epilogue", "reduce_argmin", "reduce_sum", "store", "fence_proxy"]},
          "role": {"$ref": "#/$defs/name"},
          "reads": {"$ref": "#/$defs/names"},
          "writes": {"$ref": "#/$defs/names"},
          "waits": {"$ref": "#/$defs/names"},
          "signals": {"$ref": "#/$defs/names"},
          "depends_on": {"$ref": "#/$defs/names"},
          "pipeline": {"$ref": "#/$defs/name"},
          "parameters": {"type": "object"}
        }
      }
    },
    "outputs": {"$ref": "#/$defs/names"},
    "metadata": {
      "type": "object",
      "required": ["profile"],
      "properties": {
        "profile": {"enum": ["flash_kmeans_b32_smoke", "flash_kmeans_assignment_full", "tinygemm2_stage4_split_k"]}
      }
    }
  },
  "oneOf": [
    {"required": ["grid"], "not": {"required": ["program_map"]}},
    {"required": ["program_map"], "not": {"required": ["grid"]}}
  ],
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "names": {"type": "array", "items": {"$ref": "#/$defs/name"}},
    "grid": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false}
  }
}
