{
  "schema_version": 1,
  "schedule_id": "triton-kmeans-partials",
  "target": "sm_100a",
  "roles": [
    {
      "name": "compute",
      "warps": [
        0,
        1,
        2,
        3
      ]
    }
  ],
  "allocations": [],
  "buffers": [
    {
      "name": "tokens",
      "space": "global",
      "dtype": "bf16",
      "shape": [
        32,
        512,
        128
      ],
      "mode": "input"
    },
    {
      "name": "centroids",
      "space": "global",
      "dtype": "bf16",
      "shape": [
        32,
        1024,
        128
      ],
      "mode": "input"
    },
    {
      "name": "centroid_sq",
      "space": "global",
      "dtype": "fp32",
      "shape": [
        32,
        1024
      ],
      "mode": "input"
    },
    {
      "name": "assignments",
      "space": "global",
      "dtype": "int32",
      "shape": [
        32,
        512
      ],
      "mode": "output"
    },
    {
      "name": "token_tile",
      "space": "register",
      "dtype": "bf16",
      "shape": [
        256,
        128
      ],
      "mode": "scratch"
    },
    {
      "name": "centroid_tile",
      "space": "register",
      "dtype": "bf16",
      "shape": [
        64,
        128
      ],
      "mode": "scratch"
    },
    {
      "name": "distance_tile",
      "space": "register",
      "dtype": "fp32",
      "shape": [
        256,
        64
      ],
      "mode": "scratch"
    },
    {
      "name": "best_index_tile",
      "space": "register",
      "dtype": "int32",
      "shape": [
        256
      ],
      "mode": "scratch"
    },
    {
      "name": "norm_tile",
      "space": "register",
      "dtype": "fp32",
      "shape": [
        64
      ],
      "mode": "scratch"
    },
    {
      "name": "cross",
      "space": "register",
      "dtype": "fp32",
      "shape": [
        256,
        64
      ],
      "mode": "scratch"
    },
    {
      "name": "scaled_cross",
      "space": "register",
      "dtype": "fp32",
      "shape": [
        256,
        64
      ],
      "mode": "scratch"
    },
    {
      "name": "cross_even",
      "space": "register",
      "dtype": "fp32",
      "shape": [
        256,
        64
      ],
      "mode": "scratch"
    },
    {
      "name": "cross_odd",
      "space": "register",
      "dtype": "fp32",
      "shape": [
        256,
        64
      ],
      "mode": "scratch"
    }
  ],
  "pipelines": [],
  "barriers": [],
  "operations": [
    {
      "id": "load_tokens",
      "kind": "load",
      "role": "compute",
      "reads": [
        "tokens"
      ],
      "writes": [
        "token_tile"
      ],
      "parameters": {
        "movement": "global"
      }
    },
    {
      "id": "load_centroids",
      "kind": "load",
      "role": "compute",
      "reads": [
        "centroids"
      ],
      "writes": [
        "centroid_tile"
      ],
      "parameters": {
        "movement": "global"
      }
    },
    {
      "id": "load_norm",
      "kind": "load",
      "role": "compute",
      "reads": [
        "centroid_sq"
      ],
      "writes": [
        "norm_tile"
      ],
      "parameters": {
        "movement": "global"
      }
    },
    {
      "id": "distance_mma_even",
      "kind": "mma",
      "role": "compute",
      "reads": [
        "token_tile",
        "centroid_tile"
      ],
      "writes": [
        "cross_even"
      ],
      "depends_on": [
        "load_tokens",
        "load_centroids"
      ],
      "parameters": {
        "accumulator": "fp32",
        "instruction": {
          "contract": "triton.dot.bf16_fp32"
        },
        "tile_shape": [
          256,
          64,
          128
        ],
        "k_ranges": [
          [
            0,
            16
          ],
          [
            32,
            48
          ],
          [
            64,
            80
          ],
          [
            96,
            112
          ]
        ]
      }
    },
    {
      "id": "distance_mma_odd",
      "kind": "mma",
      "role": "compute",
      "reads": [
        "token_tile",
        "centroid_tile"
      ],
      "writes": [
        "cross_odd"
      ],
      "depends_on": [
        "load_tokens",
        "load_centroids"
      ],
      "parameters": {
        "accumulator": "fp32",
        "instruction": {
          "contract": "triton.dot.bf16_fp32"
        },
        "tile_shape": [
          256,
          64,
          128
        ],
        "k_ranges": [
          [
            16,
            32
          ],
          [
            48,
            64
          ],
          [
            80,
            96
          ],
          [
            112,
            128
          ]
        ]
      }
    },
    {
      "id": "distance_mma",
      "kind": "elementwise",
      "role": "compute",
      "reads": [
        "cross_even",
        "cross_odd"
      ],
      "writes": [
        "cross"
      ],
      "parameters": {
        "op": "add"
      },
      "depends_on": [
        "distance_mma_even",
        "distance_mma_odd"
      ]
    },
    {
      "id": "scale_cross",
      "kind": "elementwise",
      "role": "compute",
      "reads": [
        "cross"
      ],
      "writes": [
        "scaled_cross"
      ],
      "depends_on": [
        "distance_mma"
      ],
      "parameters": {
        "op": "mul",
        "scalar": 2.0
      }
    },
    {
      "id": "distance",
      "kind": "elementwise",
      "role": "compute",
      "reads": [
        "norm_tile",
        "scaled_cross"
      ],
      "writes": [
        "distance_tile"
      ],
      "depends_on": [
        "scale_cross",
        "load_norm"
      ],
      "parameters": {
        "op": "sub",
        "broadcast_axis": 1
      }
    },
    {
      "id": "argmin",
      "kind": "reduce_argmin",
      "role": "compute",
      "reads": [
        "distance_tile"
      ],
      "writes": [
        "best_index_tile"
      ],
      "depends_on": [
        "distance_mma"
      ],
      "parameters": {
        "tie_break": "lowest_index",
        "nan_policy": "reject_input",
        "across_loop": true
      }
    },
    {
      "id": "store_assignment",
      "kind": "store",
      "role": "compute",
      "reads": [
        "best_index_tile"
      ],
      "writes": [
        "assignments"
      ],
      "depends_on": [
        "argmin"
      ],
      "parameters": {
        "coalesced": true
      }
    }
  ],
  "outputs": [
    "assignments"
  ],
  "program_map": {
    "axes": [
      {
        "name": "token_block",
        "axis": 0,
        "buffer": "tokens",
        "dimension": 1,
        "tile": 256
      },
      {
        "name": "batch",
        "axis": 1,
        "buffer": "tokens",
        "dimension": 0,
        "tile": 1
      }
    ]
  },
  "tile_loops": [
    {
      "name": "centroid_loop",
      "iterator": "centroid_start",
      "buffer": "centroids",
      "dimension": 1,
      "tile": 64,
      "body": [
        "load_centroids",
        "load_norm",
        "distance_mma_even",
        "distance_mma_odd",
        "distance_mma",
        "scale_cross",
        "distance",
        "argmin"
      ],
      "range_options": {
        "num_stages": 2,
        "loop_unroll_factor": 1,
        "flatten": false,
        "warp_specialize": false,
        "disallow_acc_multi_buffer": true,
        "disable_licm": false
      }
    }
  ],
  "access_maps": [
    {
      "operation": "load_tokens",
      "buffer": "tokens",
      "indices": [
        {
          "source": "program",
          "name": "batch"
        },
        {
          "source": "program_tile",
          "name": "token_block"
        },
        {
          "source": "dimension",
          "dimension": 2
        }
      ],
      "boundary": "mask_tiled_axes"
    },
    {
      "operation": "load_centroids",
      "buffer": "centroids",
      "indices": [
        {
          "source": "program",
          "name": "batch"
        },
        {
          "source": "loop_tile",
          "name": "centroid_start"
        },
        {
          "source": "dimension",
          "dimension": 2
        }
      ],
      "boundary": "mask_tiled_axes"
    },
    {
      "operation": "load_norm",
      "buffer": "centroid_sq",
      "indices": [
        {
          "source": "program",
          "name": "batch"
        },
        {
          "source": "loop_tile",
          "name": "centroid_start"
        }
      ],
      "boundary": "mask_tiled_axes"
    },
    {
      "operation": "store_assignment",
      "buffer": "assignments",
      "indices": [
        {
          "source": "program",
          "name": "batch"
        },
        {
          "source": "program_tile",
          "name": "token_block"
        }
      ],
      "boundary": "mask_tiled_axes"
    }
  ],
  "metadata": {},
  "lowering": {
    "backend": "triton",
    "entry_point": "cake_flash_kmeans_assign"
  }
}
