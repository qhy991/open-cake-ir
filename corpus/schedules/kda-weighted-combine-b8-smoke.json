      "dtype": "bf16",
      "shape": [8, 16],
      "mode": "output"
    },
    {
      "name": "expert_id_tile",
      "space": "register",
      "dtype": "int32",
      "shape": [8],
      "mode": "scratch"
    },
    {
      "name": "row_id_tile",
      "space": "register",
      "dtype": "int32",
      "shape": [8],
