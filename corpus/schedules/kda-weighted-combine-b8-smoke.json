  "operations": [
    {
      "id": "load_expert_ids",
      "kind": "load",
      "role": "compute",
      "reads": ["expert_ids"],
      "writes": ["expert_id_tile"],
      "parameters": {"movement": "global", "reuse": "streamed"}
    },
    {
      "id": "load_row_ids",
      "kind": "load",
      "role": "compute",
      "reads": ["row_ids"],
      "writes": ["row_id_tile"],
      "parameters": {"movement": "global", "reuse": "streamed"}
    },
    {
      "id": "load_route_weights",
      "kind": "load",
      "role": "compute",
      "reads": ["route_weights"],
      "writes": ["route_weight_tile"],
      "parameters": {"movement": "global", "reuse": "streamed"}
    },
    {
      "id": "load_selected_rows",
      "kind": "load",
      "role": "compute",
      "reads": ["expert_rows", "expert_id_tile", "row_id_tile"],
      "writes": ["selected_rows"],
      "depends_on": ["load_expert_ids", "load_row_ids"],
      "parameters": {"movement": "global", "reuse": "streamed"}
    },
    {
      "id": "apply_route_weights",
      "kind": "elementwise",
      "role": "compute",
      "reads": ["selected_rows", "route_weight_tile"],
      "writes": ["weighted_rows"],
      "depends_on": ["load_selected_rows", "load_route_weights"],
      "parameters": {"op": "mul", "broadcast_axis": 0}
    },
    {
      "id": "combine_routes",
      "kind": "reduce",
      "role": "compute",
      "reads": ["weighted_rows"],
      "writes": ["combined_row"],
      "depends_on": ["apply_route_weights"],
      "parameters": {"op": "sum", "axis": 0, "scope": "cta"}
    },
    {
      "id": "store_output",
      "kind": "store",
      "role": "compute",
      "reads": ["combined_row"],
      "writes": ["output"],
      "depends_on": ["combine_routes"],
      "parameters": {"coalesced": true}
    }
  ],
  "outputs": ["output"],
  "program_map": {
    "axes": [
      {
