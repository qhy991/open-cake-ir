    {"name": "output", "space": "global", "dtype": "fp32", "shape": [8, 4], "mode": "output"},
    {"name": "left_tile", "space": "register", "dtype": "bf16", "shape": [8], "mode": "scratch"},
    {"name": "right_tile", "space": "register", "dtype": "bf16", "shape": [4], "mode": "scratch"},
