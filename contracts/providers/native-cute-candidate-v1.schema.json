{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kernel_source",
    "grid",
    "block",
    "dynamic_shared_memory_bytes"
  ],
  "properties": {
    "kernel_source": {
      "type": "string",
      "minLength": 1
    },
    "grid": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "block": {
      "const": [
        32,
        1,
        1
      ]
    },
    "dynamic_shared_memory_bytes": {
      "type": "integer",
      "const": 0
    }
  }
}
