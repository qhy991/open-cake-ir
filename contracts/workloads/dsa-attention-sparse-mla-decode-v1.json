    "model": "DeepSeek-V3.2",
    "stage": "sparse_mla_decode_dsa",
    "definition": "for each query row and head, gather nonnegative token-level sparse indices, form logits=(q_nope@ckv^T + q_pe@kpe^T)*sm_scale, softmax over valid entries, and multiply by ckv values",
