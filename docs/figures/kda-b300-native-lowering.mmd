flowchart TB
  subgraph prep["已独立验证的准备阶段；当前仍物化中间值"]
    raw["Q / K / G / beta / A_log / dt_bias"] --> factors["归一化、decay 前缀、两次 MMA 与耦合"]
    factors --> base_b["base B: BF16 K128 × C32"]
    factors --> coeff["P: BF16 C32 × C32"]
    factors --> correction_b["correction B: BF16 N128 × K32"]
    factors --> prefix["prefix_end: FP32 K128"]
  end

  subgraph state["单 CTA、两 chunk 的有界状态原型"]
    old_state["BF16 state, TMEM 128 × 128"] --> base["TMA + tcgen05 基础投影"]
    base_b --> base
    base --> rhs["FP32 RHS（此原型为合成输入）"]
    rhs --> solve["按 token 顺序的 FP32 前代入求解"]
    coeff --> solve
    solve --> updates["BF16 U, TMEM"]
    updates --> correction["TMA + tcgen05 校正投影"]
    correction_b --> correction
    old_state --> read_state["按当前 phase 读取 BF16 TMEM"]
    read_state --> decay["FP32 衰减乘法"]
    prefix --> decay
    decay --> combine["FP32 相加与 BF16 舍入"]
    correction --> combine
    combine --> old_state
  end
