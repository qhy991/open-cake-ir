#include <cuda_bf16.h>
#include <mma.h>
#include <stdint.h>

extern "C" __global__ void cake_flash_kmeans_assign(
    const __nv_bfloat16* __restrict__ tokens,
    const __nv_bfloat16* __restrict__ centroids,
    const float* __restrict__ centroid_sq,
    int32_t* __restrict__ assignments) {
  using namespace nvcuda;

  constexpr int kN = 65536;
  constexpr int kD = 128;
  constexpr int kK = 1024;
  constexpr int kTokensPerBlock = 128;
  constexpr int kTokensPerWarp = 64;
  constexpr int kTokenStride = 136;
  constexpr int kVectorsPerToken = 16;
  constexpr int kSharedVectorStride = 17;

  __shared__ __align__(32)
      __nv_bfloat16 token_tile[kTokensPerBlock * kTokenStride];
  __shared__ __align__(32) float score_tile[2][4][16 * 16];

  const int b = static_cast<int>(blockIdx.y);
  const int block_token = static_cast<int>(blockIdx.x) * kTokensPerBlock;
  const long long token_base =
      (static_cast<long long>(b) * kN + block_token) * kD;

  const uint4* token_vectors =
      reinterpret_cast<const uint4*>(tokens + token_base);
  uint4* shared_vectors = reinterpret_cast<uint4*>(token_tile);
  #pragma unroll
  for (int v = static_cast<int>(threadIdx.x);
       v < kTokensPerBlock * kVectorsPerToken;
       v += static_cast<int>(blockDim.x)) {
    const int row = v >> 4;
    const int column_vector = v & 15;
    shared_vectors[row * kSharedVectorStride + column_vector] =
        token_vectors[v];
  }
  __syncthreads();

  const int warp = static_cast<int>(threadIdx.x) >> 5;
  const int lane = static_cast<int>(threadIdx.x) & 31;
  const int warp_token = warp * kTokensPerWarp;
  const long long norm_base = static_cast<long long>(b) * kK;

  float best0 = 3.402823466e+38F;
  float best1 = 3.402823466e+38F;
  int best_k0 = 0;
  int best_k1 = 0;

  #pragma unroll 1
  for (int k0 = 0; k0 < kK; k0 += 32) {
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> acc00;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> acc01;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> acc02;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> acc03;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> acc10;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> acc11;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> acc12;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> acc13;
    wmma::fill_fragment(acc00, 0.0F);
    wmma::fill_fragment(acc01, 0.0F);
    wmma::fill_fragment(acc02, 0.0F);
    wmma::fill_fragment(acc03, 0.0F);
    wmma::fill_fragment(acc10, 0.0F);
    wmma::fill_fragment(acc11, 0.0F);
    wmma::fill_fragment(acc12, 0.0F);
    wmma::fill_fragment(acc13, 0.0F);

    #pragma unroll
    for (int d0 = 0; d0 < kD; d0 += 16) {
      wmma::fragment<wmma::matrix_a, 16, 16, 16,
                     __nv_bfloat16, wmma::row_major> a0;
      wmma::fragment<wmma::matrix_a, 16, 16, 16,
                     __nv_bfloat16, wmma::row_major> a1;
      wmma::fragment<wmma::matrix_b, 16, 16, 16,
                     __nv_bfloat16, wmma::col_major> x;

      const __nv_bfloat16* a_ptr =
          centroids +
          (static_cast<long long>(b) * kK + k0) * kD + d0;
      wmma::load_matrix_sync(a0, a_ptr, kD);
      wmma::load_matrix_sync(a1, a_ptr + 16 * kD, kD);

      wmma::load_matrix_sync(
          x, token_tile + (warp_token + 0) * kTokenStride + d0,
          kTokenStride);
      wmma::mma_sync(acc00, a0, x, acc00);
      wmma::mma_sync(acc10, a1, x, acc10);

      wmma::load_matrix_sync(
          x, token_tile + (warp_token + 16) * kTokenStride + d0,
          kTokenStride);
      wmma::mma_sync(acc01, a0, x, acc01);
      wmma::mma_sync(acc11, a1, x, acc11);

      wmma::load_matrix_sync(
          x, token_tile + (warp_token + 32) * kTokenStride + d0,
          kTokenStride);
      wmma::mma_sync(acc02, a0, x, acc02);
      wmma::mma_sync(acc12, a1, x, acc12);

      wmma::load_matrix_sync(
          x, token_tile + (warp_token + 48) * kTokenStride + d0,
          kTokenStride);
      wmma::mma_sync(acc03, a0, x, acc03);
      wmma::mma_sync(acc13, a1, x, acc13);
    }

    const int column = lane & 15;
    const int first_tile = lane >> 4;

    wmma::store_matrix_sync(
        &score_tile[warp][0][0], acc00, 16, wmma::mem_row_major);
    wmma::store_matrix_sync(
        &score_tile[warp][1][0], acc01, 16, wmma::mem_row_major);
    wmma::store_matrix_sync(
        &score_tile[warp][2][0], acc02, 16, wmma::mem_row_major);
    wmma::store_matrix_sync(
        &score_tile[warp][3][0], acc03, 16, wmma::mem_row_major);
    __syncwarp();

    #pragma unroll
    for (int r = 0; r < 16; ++r) {
      const int k = k0 + r;
      const float norm = centroid_sq[norm_base + k];
      const float dot0 =
          score_tile[warp][first_tile][r * 16 + column];
      const float dot1 =
          score_tile[warp][first_tile + 2][r * 16 + column];
      const float candidate0 = norm - 2.0F * dot0;
      const float candidate1 = norm - 2.0F * dot1;
      if (candidate0 < best0) {
        best0 = candidate0;
        best_k0 = k;
      }
      if (candidate1 < best1) {
        best1 = candidate1;
        best_k1 = k;
      }
    }
    __syncwarp();

    wmma::store_matrix_sync(
        &score_tile[warp][0][0], acc10, 16, wmma::mem_row_major);
    wmma::store_matrix_sync(
        &score_tile[warp][1][0], acc11, 16, wmma::mem_row_major);
    wmma::store_matrix_sync(
        &score_tile[warp][2][0], acc12, 16, wmma::mem_row_major);
    wmma::store_matrix_sync(
        &score_tile[warp][3][0], acc13, 16, wmma::mem_row_major);
    __syncwarp();

    #pragma unroll
    for (int r = 0; r < 16; ++r) {
      const int k = k0 + 16 + r;
      const float norm = centroid_sq[norm_base + k];
      const float dot0 =
          score_tile[warp][first_tile][r * 16 + column];
      const float dot1 =
          score_tile[warp][first_tile + 2][r * 16 + column];
      const float candidate0 = norm - 2.0F * dot0;
      const float candidate1 = norm - 2.0F * dot1;
      if (candidate0 < best0) {
        best0 = candidate0;
        best_k0 = k;
      }
      if (candidate1 < best1) {
        best1 = candidate1;
        best_k1 = k;
      }
    }
    __syncwarp();
  }

  const long long output_base =
      static_cast<long long>(b) * kN + block_token;
  assignments[output_base + warp_token + lane] = best_k0;
  assignments[output_base + warp_token + lane + 32] = best_k1;
}
