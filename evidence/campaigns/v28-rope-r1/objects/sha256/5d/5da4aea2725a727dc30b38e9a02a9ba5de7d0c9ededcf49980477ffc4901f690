// CAKE_REPRO_LAUNCH_V1 {"abi":"flash_kmeans_assign_v1","block":[64,1,1],"dynamic_shared_memory_bytes":0,"grid":[512,32,1],"kernel_name":"cake_flash_kmeans_assign","schema_version":1,"target":"sm_100a"}
#include <cuda_bf16.h>
#include <mma.h>
#include <stdint.h>

extern "C" __global__ void cake_flash_kmeans_assign(
    const __nv_bfloat16* tokens,
    const __nv_bfloat16* centroids,
    const float* centroid_sq,
    int32_t* assignments) {
  using namespace nvcuda;

  constexpr int kN = 65536;
  constexpr int kD = 128;
  constexpr int kK = 1024;
  constexpr int kTokensPerBlock = 128;
  constexpr int kTokensPerWarp = 64;
  constexpr int kTokenTileVectors = 2048;

  __shared__ __align__(16) __nv_bfloat16
      token_tile[kTokensPerBlock * kD];
  __shared__ float score_tile[2][4][16 * 16];

  const int b = static_cast<int>(blockIdx.y);
  const int block_token = static_cast<int>(blockIdx.x) * kTokensPerBlock;
  const long long token_base =
      (static_cast<long long>(b) * kN + block_token) * kD;

  const int4* token_vectors =
      reinterpret_cast<const int4*>(tokens + token_base);
  int4* tile_vectors = reinterpret_cast<int4*>(token_tile);
  for (int i = static_cast<int>(threadIdx.x);
       i < kTokenTileVectors;
       i += static_cast<int>(blockDim.x)) {
    tile_vectors[i] = token_vectors[i];
  }
  __syncthreads();

  const int warp = static_cast<int>(threadIdx.x) >> 5;
  const int lane = static_cast<int>(threadIdx.x) & 31;
  const int warp_token = warp * kTokensPerWarp;
  const int column = lane & 15;
  const int first_tile = lane >> 4;

  float best0 = 3.402823466e+38F;
  float best1 = 3.402823466e+38F;
  int best_k0 = 0;
  int best_k1 = 0;

  #pragma unroll 1
  for (int k0 = 0; k0 < kK; k0 += 32) {
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> lo0;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> lo1;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> lo2;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> lo3;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> hi0;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> hi1;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> hi2;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> hi3;
    wmma::fill_fragment(lo0, 0.0F);
    wmma::fill_fragment(lo1, 0.0F);
    wmma::fill_fragment(lo2, 0.0F);
    wmma::fill_fragment(lo3, 0.0F);
    wmma::fill_fragment(hi0, 0.0F);
    wmma::fill_fragment(hi1, 0.0F);
    wmma::fill_fragment(hi2, 0.0F);
    wmma::fill_fragment(hi3, 0.0F);

    #pragma unroll
    for (int d0 = 0; d0 < kD; d0 += 16) {
      wmma::fragment<wmma::matrix_a, 16, 16, 16,
                     __nv_bfloat16, wmma::row_major> a_lo;
      wmma::fragment<wmma::matrix_a, 16, 16, 16,
                     __nv_bfloat16, wmma::row_major> a_hi;
      wmma::fragment<wmma::matrix_b, 16, 16, 16,
                     __nv_bfloat16, wmma::col_major> x;

      const __nv_bfloat16* centroid_batch =
          centroids + static_cast<long long>(b) * kK * kD;
      wmma::load_matrix_sync(
          a_lo, centroid_batch + static_cast<long long>(k0) * kD + d0, kD);
      wmma::load_matrix_sync(
          a_hi,
          centroid_batch + static_cast<long long>(k0 + 16) * kD + d0,
          kD);

      wmma::load_matrix_sync(
          x, token_tile + (warp_token + 0) * kD + d0, kD);
      wmma::mma_sync(lo0, a_lo, x, lo0);
      wmma::mma_sync(hi0, a_hi, x, hi0);

      wmma::load_matrix_sync(
          x, token_tile + (warp_token + 16) * kD + d0, kD);
      wmma::mma_sync(lo1, a_lo, x, lo1);
      wmma::mma_sync(hi1, a_hi, x, hi1);

      wmma::load_matrix_sync(
          x, token_tile + (warp_token + 32) * kD + d0, kD);
      wmma::mma_sync(lo2, a_lo, x, lo2);
      wmma::mma_sync(hi2, a_hi, x, hi2);

      wmma::load_matrix_sync(
          x, token_tile + (warp_token + 48) * kD + d0, kD);
      wmma::mma_sync(lo3, a_lo, x, lo3);
      wmma::mma_sync(hi3, a_hi, x, hi3);
    }

    wmma::store_matrix_sync(
        &score_tile[warp][0][0], lo0, 16, wmma::mem_row_major);
    wmma::store_matrix_sync(
        &score_tile[warp][1][0], lo1, 16, wmma::mem_row_major);
    wmma::store_matrix_sync(
        &score_tile[warp][2][0], lo2, 16, wmma::mem_row_major);
    wmma::store_matrix_sync(
        &score_tile[warp][3][0], lo3, 16, wmma::mem_row_major);
    __syncwarp();

    #pragma unroll
    for (int r = 0; r < 16; ++r) {
      const int k = k0 + r;
      const float norm =
          centroid_sq[static_cast<long long>(b) * kK + k];
      const float dot0 =
          score_tile[warp][first_tile][r * 16 + column];
      const float dot1 =
          score_tile[warp][first_tile + 2][r * 16 + column];
      const float candidate0 = norm - 2.0F * dot0;
      const float candidate1 = norm - 2.0F * dot1;
      if (candidate0 < best0) {
        best0 = candidate0;
        best_k0 = k;
      }
      if (candidate1 < best1) {
        best1 = candidate1;
        best_k1 = k;
      }
    }
    __syncwarp();

    wmma::store_matrix_sync(
        &score_tile[warp][0][0], hi0, 16, wmma::mem_row_major);
    wmma::store_matrix_sync(
        &score_tile[warp][1][0], hi1, 16, wmma::mem_row_major);
    wmma::store_matrix_sync(
        &score_tile[warp][2][0], hi2, 16, wmma::mem_row_major);
    wmma::store_matrix_sync(
        &score_tile[warp][3][0], hi3, 16, wmma::mem_row_major);
    __syncwarp();

    #pragma unroll
    for (int r = 0; r < 16; ++r) {
      const int k = k0 + 16 + r;
      const float norm =
          centroid_sq[static_cast<long long>(b) * kK + k];
      const float dot0 =
          score_tile[warp][first_tile][r * 16 + column];
      const float dot1 =
          score_tile[warp][first_tile + 2][r * 16 + column];
      const float candidate0 = norm - 2.0F * dot0;
      const float candidate1 = norm - 2.0F * dot1;
      if (candidate0 < best0) {
        best0 = candidate0;
        best_k0 = k;
      }
      if (candidate1 < best1) {
        best1 = candidate1;
        best_k1 = k;
      }
    }
    __syncwarp();
  }

  const long long output_base = static_cast<long long>(b) * kN + block_token;
  assignments[output_base + warp_token + lane] = best_k0;
  assignments[output_base + warp_token + lane + 32] = best_k1;
}
