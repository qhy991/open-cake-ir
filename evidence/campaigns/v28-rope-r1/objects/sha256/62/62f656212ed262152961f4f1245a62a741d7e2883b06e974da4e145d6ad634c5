// CAKE_REPRO_LAUNCH_V1 {"abi":"flash_kmeans_assign_v1","block":[64,1,1],"dynamic_shared_memory_bytes":0,"grid":[512,32,1],"kernel_name":"cake_flash_kmeans_assign","schema_version":1,"target":"sm_100a"}
#include <cuda_bf16.h>
#include <mma.h>
#include <stdint.h>
#include <vector_types.h>

extern "C" __global__ void cake_flash_kmeans_assign(
    const __nv_bfloat16* tokens,
    const __nv_bfloat16* centroids,
    const float* centroid_sq,
    int32_t* assignments) {
  using namespace nvcuda;

  constexpr int kN = 65536;
  constexpr int kD = 128;
  constexpr int kK = 1024;
  constexpr int kTokensPerBlock = 128;
  constexpr int kTokensPerWarp = 64;
  constexpr int kDTiles = kD / 16;

  __shared__ __align__(32) __nv_bfloat16
      token_tile[kTokensPerBlock * kD];
  __shared__ __align__(32) __nv_bfloat16 centroid_tile[16 * kD];
  __shared__ __align__(16) float norm_tile[kK];
  __shared__ __align__(32) float score_tile[2][4][16 * 16];

  const int b = static_cast<int>(blockIdx.y);
  const int block_token = static_cast<int>(blockIdx.x) * kTokensPerBlock;
  const long long token_base =
      (static_cast<long long>(b) * kN + block_token) * kD;

  const uint4* token_src =
      reinterpret_cast<const uint4*>(tokens + token_base);
  uint4* token_dst = reinterpret_cast<uint4*>(token_tile);
  #pragma unroll 1
  for (int segment = static_cast<int>(threadIdx.x);
       segment < kTokensPerBlock * kDTiles;
       segment += static_cast<int>(blockDim.x)) {
    const int token = segment / kDTiles;
    const int d_tile = segment - token * kDTiles;
    const int token_group = token >> 4;
    const int token_in_group = token & 15;
    const int packed_segment =
        (token_group * kDTiles + d_tile) * 16 + token_in_group;
    const uint4* src = token_src + segment * 2;
    uint4* dst = token_dst + packed_segment * 2;
    dst[0] = src[0];
    dst[1] = src[1];
  }

  const uint4* norm_src = reinterpret_cast<const uint4*>(
      centroid_sq + static_cast<long long>(b) * kK);
  uint4* norm_dst = reinterpret_cast<uint4*>(norm_tile);
  #pragma unroll
  for (int i = static_cast<int>(threadIdx.x); i < kK / 4;
       i += static_cast<int>(blockDim.x)) {
    norm_dst[i] = norm_src[i];
  }
  __syncthreads();

  const int warp = static_cast<int>(threadIdx.x) >> 5;
  const int lane = static_cast<int>(threadIdx.x) & 31;
  const int warp_token = warp * kTokensPerWarp;
  const int warp_token_group = warp * 4;
  uint4* centroid_dst = reinterpret_cast<uint4*>(centroid_tile);

  float best0 = 3.402823466e+38F;
  float best1 = 3.402823466e+38F;
  int best_k0 = 0;
  int best_k1 = 0;

  #pragma unroll 1
  for (int k0 = 0; k0 < kK; k0 += 16) {
    #pragma unroll
    for (int segment = static_cast<int>(threadIdx.x);
         segment < 16 * kDTiles;
         segment += static_cast<int>(blockDim.x)) {
      const int centroid = segment / kDTiles;
      const int d_tile = segment - centroid * kDTiles;
      const int packed_segment = d_tile * 16 + centroid;
      const __nv_bfloat16* src_base =
          centroids +
          (static_cast<long long>(b) * kK + k0 + centroid) * kD +
          d_tile * 16;
      const uint4* src = reinterpret_cast<const uint4*>(src_base);
      uint4* dst = centroid_dst + packed_segment * 2;
      dst[0] = src[0];
      dst[1] = src[1];
    }
    __syncthreads();

    wmma::fragment<wmma::accumulator, 16, 16, 16, float> acc0;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> acc1;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> acc2;
    wmma::fragment<wmma::accumulator, 16, 16, 16, float> acc3;
    wmma::fill_fragment(acc0, 0.0F);
    wmma::fill_fragment(acc1, 0.0F);
    wmma::fill_fragment(acc2, 0.0F);
    wmma::fill_fragment(acc3, 0.0F);

    #pragma unroll
    for (int d0 = 0; d0 < kD; d0 += 16) {
      wmma::fragment<wmma::matrix_a, 16, 16, 16,
                     __nv_bfloat16, wmma::row_major> a;
      wmma::fragment<wmma::matrix_b, 16, 16, 16,
                     __nv_bfloat16, wmma::col_major> x;

      const int d_tile = d0 >> 4;
      wmma::load_matrix_sync(
          a, centroid_tile + d_tile * 256, 16);
      wmma::load_matrix_sync(
          x, token_tile +
                 ((warp_token_group + 0) * kDTiles + d_tile) * 256,
          16);
      wmma::mma_sync(acc0, a, x, acc0);
      wmma::load_matrix_sync(
          x, token_tile +
                 ((warp_token_group + 1) * kDTiles + d_tile) * 256,
          16);
      wmma::mma_sync(acc1, a, x, acc1);
      wmma::load_matrix_sync(
          x, token_tile +
                 ((warp_token_group + 2) * kDTiles + d_tile) * 256,
          16);
      wmma::mma_sync(acc2, a, x, acc2);
      wmma::load_matrix_sync(
          x, token_tile +
                 ((warp_token_group + 3) * kDTiles + d_tile) * 256,
          16);
      wmma::mma_sync(acc3, a, x, acc3);
    }
    __syncthreads();

    wmma::store_matrix_sync(
        &score_tile[warp][0][0], acc0, 16, wmma::mem_row_major);
    wmma::store_matrix_sync(
        &score_tile[warp][1][0], acc1, 16, wmma::mem_row_major);
    wmma::store_matrix_sync(
        &score_tile[warp][2][0], acc2, 16, wmma::mem_row_major);
    wmma::store_matrix_sync(
        &score_tile[warp][3][0], acc3, 16, wmma::mem_row_major);
    __syncwarp();

    const int column = lane & 15;
    const int first_tile = lane >> 4;
    #pragma unroll
    for (int r = 0; r < 16; ++r) {
      const int k = k0 + r;
      const float norm = norm_tile[k];
      const float dot0 = score_tile[warp][first_tile][r * 16 + column];
      const float dot1 =
          score_tile[warp][first_tile + 2][r * 16 + column];
      const float candidate0 = norm - 2.0F * dot0;
      const float candidate1 = norm - 2.0F * dot1;
      if (candidate0 < best0) {
        best0 = candidate0;
        best_k0 = k;
      }
      if (candidate1 < best1) {
        best1 = candidate1;
        best_k1 = k;
      }
    }
    __syncwarp();
  }

  const long long output_base =
      static_cast<long long>(b) * kN + block_token;
  assignments[output_base + warp_token + lane] = best_k0;
  assignments[output_base + warp_token + lane + 32] = best_k1;
}
