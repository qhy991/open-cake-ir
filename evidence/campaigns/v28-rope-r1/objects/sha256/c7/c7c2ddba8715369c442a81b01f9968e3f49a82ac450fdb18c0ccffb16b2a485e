#include <cuda_bf16.h>
#include <mma.h>
#include <stdint.h>

using CakeAccumulator =
    nvcuda::wmma::fragment<nvcuda::wmma::accumulator,
                           16, 16, 16, float>;

__device__ __forceinline__ void cake_reduce_score_pair(
    const CakeAccumulator& left,
    const CakeAccumulator& right,
    float* scores,
    const float* centroid_sq,
    long long norm_base,
    int k0,
    int lane,
    float& best,
    int& best_k) {
  nvcuda::wmma::store_matrix_sync(
      scores, left, 16, nvcuda::wmma::mem_row_major);
  nvcuda::wmma::store_matrix_sync(
      scores + 16 * 16, right, 16, nvcuda::wmma::mem_row_major);
  __syncwarp();

  const int column = lane & 15;
  const int tile = lane >> 4;
  #pragma unroll
  for (int r = 0; r < 16; ++r) {
    const int k = k0 + r;
    const float candidate =
        centroid_sq[norm_base + k] -
        2.0F * scores[tile * 16 * 16 + r * 16 + column];
    if (candidate < best) {
      best = candidate;
      best_k = k;
    }
  }
  __syncwarp();
}

extern "C" __global__ void cake_flash_kmeans_assign(
    const __nv_bfloat16* __restrict__ tokens,
    const __nv_bfloat16* __restrict__ centroids,
    const float* __restrict__ centroid_sq,
    int32_t* __restrict__ assignments) {
  using namespace nvcuda;

  constexpr int kN = 65536;
  constexpr int kD = 128;
  constexpr int kK = 1024;
  constexpr int kTokensPerBlock = 128;
  constexpr int kTokensPerWarp = 64;
  constexpr int kVectorsPerToken = 16;

  __shared__ __align__(32)
      __nv_bfloat16 token_tile[kTokensPerBlock * kD];
  __shared__ __align__(32) float score_pair[2][2][16 * 16];

  const int b = static_cast<int>(blockIdx.y);
  const int block_token = static_cast<int>(blockIdx.x) * kTokensPerBlock;
  const long long token_base =
      (static_cast<long long>(b) * kN + block_token) * kD;

  const uint4* token_vectors =
      reinterpret_cast<const uint4*>(tokens + token_base);
  uint4* shared_vectors = reinterpret_cast<uint4*>(token_tile);
  #pragma unroll
  for (int v = static_cast<int>(threadIdx.x);
       v < kTokensPerBlock * kVectorsPerToken;
       v += static_cast<int>(blockDim.x)) {
    const int token = v >> 4;
    const int d_vector = v & 15;
    const int warp_slot = token >> 6;
    const int token_tile_id = (token >> 4) & 3;
    const int token_column = token & 15;
    const int d_chunk = d_vector >> 1;
    const int vector_half = d_vector & 1;
    const int matrix =
        (warp_slot * 4 + token_tile_id) * 8 + d_chunk;
    shared_vectors[matrix * 32 + token_column * 2 + vector_half] =
        token_vectors[v];
  }
  __syncthreads();

  const int warp = static_cast<int>(threadIdx.x) >> 5;
  const int lane = static_cast<int>(threadIdx.x) & 31;
  const int warp_token = warp * kTokensPerWarp;
  const long long norm_base = static_cast<long long>(b) * kK;

  float best0 = 3.402823466e+38F;
  float best1 = 3.402823466e+38F;
  int best_k0 = 0;
  int best_k1 = 0;

  #pragma unroll 1
  for (int k0 = 0; k0 < kK; k0 += 32) {
    CakeAccumulator acc00;
    CakeAccumulator acc01;
    CakeAccumulator acc02;
    CakeAccumulator acc03;
    CakeAccumulator acc10;
    CakeAccumulator acc11;
    CakeAccumulator acc12;
    CakeAccumulator acc13;
    wmma::fill_fragment(acc00, 0.0F);
    wmma::fill_fragment(acc01, 0.0F);
    wmma::fill_fragment(acc02, 0.0F);
    wmma::fill_fragment(acc03, 0.0F);
    wmma::fill_fragment(acc10, 0.0F);
    wmma::fill_fragment(acc11, 0.0F);
    wmma::fill_fragment(acc12, 0.0F);
    wmma::fill_fragment(acc13, 0.0F);

    #pragma unroll
    for (int d0 = 0; d0 < kD; d0 += 16) {
      wmma::fragment<wmma::matrix_a, 16, 16, 16,
                     __nv_bfloat16, wmma::row_major> a0;
      wmma::fragment<wmma::matrix_a, 16, 16, 16,
                     __nv_bfloat16, wmma::row_major> a1;
      wmma::fragment<wmma::matrix_b, 16, 16, 16,
                     __nv_bfloat16, wmma::col_major> x;

      const __nv_bfloat16* a_ptr =
          centroids +
          (static_cast<long long>(b) * kK + k0) * kD + d0;
      wmma::load_matrix_sync(a0, a_ptr, kD);
      wmma::load_matrix_sync(a1, a_ptr + 16 * kD, kD);

      const int chunk = d0 >> 4;
      wmma::load_matrix_sync(
          x, token_tile + (warp * 32 + 0 * 8 + chunk) * 16 * 16,
          16);
      wmma::mma_sync(acc00, a0, x, acc00);
      wmma::mma_sync(acc10, a1, x, acc10);

      wmma::load_matrix_sync(
          x, token_tile + (warp * 32 + 1 * 8 + chunk) * 16 * 16,
          16);
      wmma::mma_sync(acc01, a0, x, acc01);
      wmma::mma_sync(acc11, a1, x, acc11);

      wmma::load_matrix_sync(
          x, token_tile + (warp * 32 + 2 * 8 + chunk) * 16 * 16,
          16);
      wmma::mma_sync(acc02, a0, x, acc02);
      wmma::mma_sync(acc12, a1, x, acc12);

      wmma::load_matrix_sync(
          x, token_tile + (warp * 32 + 3 * 8 + chunk) * 16 * 16,
          16);
      wmma::mma_sync(acc03, a0, x, acc03);
      wmma::mma_sync(acc13, a1, x, acc13);
    }

    float* scores = &score_pair[warp][0][0];
    cake_reduce_score_pair(
        acc00, acc02, scores, centroid_sq, norm_base,
        k0, lane, best0, best_k0);
    cake_reduce_score_pair(
        acc01, acc03, scores, centroid_sq, norm_base,
        k0, lane, best1, best_k1);
    cake_reduce_score_pair(
        acc10, acc12, scores, centroid_sq, norm_base,
        k0 + 16, lane, best0, best_k0);
    cake_reduce_score_pair(
        acc11, acc13, scores, centroid_sq, norm_base,
        k0 + 16, lane, best1, best_k1);
  }

  const int column = lane & 15;
  const int first_token = (lane >> 4) * 32 + column;
  const long long output_base =
      static_cast<long long>(b) * kN + block_token + warp_token;
  assignments[output_base + first_token] = best_k0;
  assignments[output_base + first_token + 16] = best_k1;
}
